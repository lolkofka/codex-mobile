<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#9BE5CC</item>
        <item name="android:windowBackground">#151A18</item>
        <item name="android:statusBarColor">#151A18</item>
        <item name="android:navigationBarColor">#151A18</item>
        <item name="android:textColorPrimary">#EDF2EF</item>
        <item name="android:textColorSecondary">#A4AFA8</item>
        <item name="android:alertDialogTheme">@style/CodexDialog</item>
    </style>
    <style name="CodexDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#9BE5CC</item>
        <item name="android:colorBackground">#19201C</item>
        <item name="android:colorBackgroundFloating">#19201C</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:textColorPrimary">#EDF2EF</item>
        <item name="android:textColorSecondary">#A4AFA8</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarButtonStyle">@style/CodexDialogButton</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">94%</item>
    </style>
    <style name="CodexDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
    </style>
</resources>
